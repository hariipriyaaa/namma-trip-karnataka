# Optional. Without a key, the app uses its curated deterministic itinerary engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
APP_NAME=Namma Trip Karnataka API
API_PREFIX=/api
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Optional route ordering via OpenStreetMap Nominatim + OSRM (external network required)
NAMMATRIP_ROUTE_OPTIMIZATION=false
# Optional self-hosted service URLs
NAMMATRIP_GEOCODER_URL=https://nominatim.openstreetmap.org/search
NAMMATRIP_OSRM_URL=https://router.project-osrm.org
